<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head.ejs') %>
        <title>404 · Page Not Found · Jules ROY</title>
</head>

<body class="text-white bg-main-color font-Satoshi flex flex-col justify-center items-center min-h-screen p-4">
    <main
        class="card max-w-lg w-full bg-second-color p-8 rounded-lg border border-border-color hover:border-third-color transition duration-75 ease-in-out text-center flex flex-col items-center gap-6">
        <span
            class="text-xs text-third-color bg-third-color/10 px-3 py-1 rounded-full border border-third-color/20 font-bold tracking-wider uppercase">
            Error 404
        </span>

        <div class="flex flex-col items-center gap-2">
            <h1 class="text-7xl sm:text-8xl font-bold font-CabinetGrotesk tracking-tight text-white m-0">
                404
            </h1>
            <h2 class="text-xl font-bold text-white mt-1">Page not found</h2>
            <p class="text-sm font-light text-gray-400 max-w-sm mt-1">
                The page you are looking for might have been removed, had its name changed, or is temporarily
                unavailable.
            </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto pt-2">
            <a href="/" aria-label="Back to home" class="flex-1 sm:flex-initial">
                <button
                    class="custom-btn text-sm max-h-[44px] w-full shadow-custom shadow-third-color active:shadow-none active:translate-x-[3px] active:translate-y-[3px] text-gray-200 px-5 py-2.5 border border-third-color hover:text-third-color transition-colors duration-100 ease-in-out bg-second-color cursor-pointer rounded-lg flex items-center justify-center gap-2 font-medium">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    <span>Back to Home</span>
                </button>
            </a>
            <a href="/projects" aria-label="View projects" class="flex-1 sm:flex-initial">
                <button
                    class="text-sm max-h-[44px] w-full text-gray-300 hover:text-white px-5 py-2.5 border border-border-color hover:border-third-color transition-colors duration-100 ease-in-out bg-main-color cursor-pointer rounded-lg flex items-center justify-center gap-2 font-medium">
                    <span>View Projects</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </button>
            </a>
        </div>

        <div class="border-t border-border-color/60 w-full pt-4 mt-2">
            <p class="text-xs text-gray-500">© 2021 - <%= new Date().getFullYear(); %> · Jules ROY</p>
        </div>
    </main>

    <script src="/js/scripts.js"></script>
</body>

</html>